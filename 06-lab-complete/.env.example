# Server Configuration
HOST=0.0.0.0
PORT=8000

# Redis
REDIS_URL=redis://redis:6379

# Security
AGENT_API_KEY=secret-key-123

# Logging
LOG_LEVEL=INFO

# Rate Limiting
RATE_LIMIT_PER_MINUTE=10

# Cost Guard
MONTHLY_BUDGET_USD=10.0
DAILY_BUDGET_USD=1.0

# App Info
APP_NAME=Production AI Agent
APP_VERSION=1.0.0
ENVIRONMENT=production

# LLM (Optional - leave empty to use mock)
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
MAX_TOKENS=500
